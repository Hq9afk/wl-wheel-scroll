post_install() {
    cat <<EOF
==> wl-wheel-scroll: two manual steps are required before scrolling works:

  1. Add yourself to the 'input' group, then log out and back in
     (group membership only takes effect on a new login session):

       sudo usermod -aG input \$USER

  2. Enable and start the user service:

       systemctl --user enable --now wl-wheel-scroll.service

  Check it detected your touchpad with:
       journalctl --user -u wl-wheel-scroll.service -b
EOF
}

post_upgrade() {
    post_install
}
